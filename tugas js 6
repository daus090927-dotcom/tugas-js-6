</head>
<body>
    <script>
        let angka = -5;

        if (angka > 0) {
                console.log(`${angka} adalah bilangan POSITIF`);
        } else if (angka < 0) {
                console.log(`${angka} adalah bilangan NEGATIF`); // Output ini yang dijalankan
        } else {
             console.log("Angka tersebut adalah NOL");
        }
    </script>
